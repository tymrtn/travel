[Unit]
Description=Sovereign Travel household service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=travel
Group=travel
StateDirectory=travel
StateDirectoryMode=0700
Environment=TRAVEL_HOME=/var/lib/travel
EnvironmentFile=/etc/travel/environment
ExecStart=/usr/local/bin/travel serve --bind 127.0.0.1 --port 3150
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
